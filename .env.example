# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
# You only need to fill the providers you actually want to use. The others
# will just show up as "not connected".
#
# See README.md for click-by-click steps to get every value below.
# ---------------------------------------------------------------------------

# The port the server listens on (optional, defaults to 3000)
PORT=3000

# --- MongoDB (Mongoose) ---
# Your MongoDB Atlas (or local) connection string.
# If your password has special characters like # or @, URL-encode them
# (for example  #  becomes  %23 ). Put the database name at the end.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.mongodb.net/cloud_file_dashboard

# --- Google Drive ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Dropbox ---
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- OneDrive (Microsoft) ---
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
